{
  "env": {
    "browser": true,
    "es2021": true,
    "googleappsscript/googleappsscript": true,
    "jest": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": ["standard"],
  "plugins": ["googleappsscript"],
  "globals": {
    "buildGreeting": "readonly",
    "getHourOfDay": "readonly",
    "sanitizeName_": "readonly",
    "getAppVersion_": "readonly",
    "removeAllProjectTriggers_": "readonly",
    "module": "readonly"
  },
  "rules": {
    "indent": ["error", 2],
    "semi": ["error", "never"],
    "space-before-function-paren": ["error", "always"],
    "no-unused-vars": "off"
  },
  "ignorePatterns": ["node_modules/", "coverage/", "**/*.html"]
}
