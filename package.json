{
  "name": "gas-cicd-demo",
  "version": "1.0.0",
  "description": "Reference CI/CD pipeline for Google Apps Script using GitHub Actions and clasp.",
  "private": true,
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate:manifest": "node -e \"JSON.parse(require('fs').readFileSync('src/appsscript.json'))\"",
    "ci": "npm run lint && npm run test && npm run validate:manifest",
    "push": "clasp push -f",
    "open": "clasp open"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
